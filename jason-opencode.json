{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "delivery",
  "plugin": ["./.opencode/plugins/prompt-fetcher"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "references": {
    "docs-context": {
      "path": "docs/context",
      "description": "Strategic project context (architecture, rules, business logic, permission system, naming). Read on demand to understand the codebase or domain rules."
    },
    "docs-protocols": {
      "path": "docs/protocols",
      "description": "Project-specific protocols and templates (e.g. api-endpoint-factory). Read on demand when a task matches a known recipe."
    },
    "opencode-protocols": {
      "path": ".opencode/protocols",
      "description": "Agent protocols (prompt-pipeline, agent-installer, broad-investigation-template). Read on demand for convention reference."
    }
  },
  "agent": {
    "delivery": {
      "model": "opencode-go/minimax-m3",
      "temperature": 0.3
    },
    "orchestrator": {
      "model": "opencode-go/kimi-k3"
    },
    "coder-angular": {
      "model": "opencode-go/kimi-k3"
    },
    "coder-go": {
      "model": "opencode-go/kimi-k3"
    },
    "reviewer": {
      "model": "opencode-go/kimi-k3"
    },
    "architect": {
      "model": "opencode-go/kimi-k3"
    },
    "analista": {
      "model": "opencode-go/kimi-k3"
    },
    "tester": {
      "model": "opencode-go/minimax-m3",
      "temperature": 0.2
    },
    "explorer": {
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1
    },
    "project-context": {
      "model": "opencode-go/minimax-m3",
      "temperature": 0.2
    },
    "vision-relay": {
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1
    },
    "external-scout": {
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1
    },
    "interpreter": {
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1
    },
    "documenter": {
      "model": "opencode-go/minimax-m3",
      "temperature": 0.2
    }
  },
  "permission": {
    "question": "allow"
  },
  "instructions": [
    "docs/project.md",
    ".opencode/protocols/prompt-pipeline.md"
  ]
}
