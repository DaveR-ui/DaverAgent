{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "delivery",
  "plugin": ["./.opencode/plugins/davercode-session-bridge"],
  "agent": {
    "delivery": {
      "description": "Delivery Agent - Sole interface between human and agent system. Translates, coordinates sessions, delegates ALL work to subagents.",
      "mode": "primary",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.3,
      "permission": {
        "skill": {},
        "task": {
          "orchestrator": "allow",
          "coder": "allow",
          "tester": "allow",
          "reviewer": "allow",
          "architect": "allow",
          "explorer": "allow",
          "project-context": "allow",
          "vision-relay": "allow",
          "external-scout": "allow"
        },
        "external_directory": {
          "~/.config/opencode/**": "allow"
        }
      }
    },
    "orchestrator": {
      "description": "Orchestrator Agent - Persistent coordinator. Receives handoff from delivery, decomposes tasks, releases subagents, and maintains state across delegations. Works exclusively in English.",
      "mode": "subagent",
      "model": "opencode-go/kimi-k3",
      "temperature": 0.3,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "task": true
      },
      "permission": {
        "skill": {},
        "task": {
          "coder": "allow",
          "tester": "allow",
          "reviewer": "allow",
          "architect": "allow",
          "explorer": "allow",
          "project-context": "allow",
          "vision-relay": "allow",
          "external-scout": "allow"
        }
      }
    },
    "coder": {
      "description": "Programming, bug fixes, feature implementation, refactoring",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true
      },
      "output_schema": "coder"
    },
    "reviewer": {
      "description": "Code review, security audit, best practices, performance",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
        "read": true
      },
      "output_schema": "reviewer"
    },
    "tester": {
      "description": "Unit tests, integration tests, test coverage, e2e",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true
      },
      "output_schema": "tester"
    },
    "architect": {
      "description": "System design, architecture, module boundaries, patterns",
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "temperature": 0.3,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true
      },
      "output_schema": "architect"
    },
    "explorer": {
      "description": "Codebase exploration, file search, dependency analysis",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
        "read": true
      },
      "output_schema": "explorer"
    },
    "project-context": {
      "description": "Project context agent - Reads and writes docs/ on demand. Knows the project structure and canonical documentation.",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "glob": true,
        "grep": true
      }
    },
    "vision-relay": {
      "description": "Vision Relay - Cheap image inspection for non-vision models. Receives one image plus one focused question, returns a compact textual answer. Does NOT explore, does NOT chain of thought, does NOT touch files.",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true
      }
    },
    "external-scout": {
      "description": "External Scout - Fetches live documentation for external Go libraries on demand. Receives a library path, version, and one focused question, returns a compact textual answer. Read-only plus webfetch.",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true,
        "webfetch": true
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "instructions": [
    "docs/project.md",
    "docs/context/README.md",
    ".opencode/session-structure.md",
    ".opencode/protocols/README.md",
    ".opencode/model-routing.md",
    ".opencode/llm-routing.md"
  ]
}
