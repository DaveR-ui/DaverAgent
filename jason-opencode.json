{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "delivery",
  "agent": {
    "delivery": {
      "description": "Delivery Agent - Sole interface between human and agent system. Translates, coordinates sessions, delegates ALL work to subagents.",
      "mode": "primary",
      "temperature": 0.3,
      "prompt": "{file:.opencode/agents/delivery.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "write": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "external_directory": {
          "~/.config/opencode/**": "allow"
        }
      }
    },
    "orchestrator": {
      "description": "Orchestrator Agent - Ephemeral coordinator. Receives handoff from delivery, decomposes tasks, releases subagents, returns structured snapshot. Works exclusively in English.",
      "mode": "subagent",
      "temperature": 0.3,
      "prompt": "{file:.opencode/agents/orchestrator.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "task": true
      }
    },
    "coder": {
      "description": "Programming, bug fixes, feature implementation, refactoring",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:.opencode/agents/subagents/coder.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true
      }
    },
    "reviewer": {
      "description": "Code review, security audit, best practices, performance",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:.opencode/agents/subagents/reviewer.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
        "read": true
      }
    },
    "tester": {
      "description": "Unit tests, integration tests, test coverage, e2e",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:.opencode/agents/subagents/tester.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true
      }
    },
    "architect": {
      "description": "System design, architecture, module boundaries, patterns",
      "mode": "subagent",
      "temperature": 0.3,
      "prompt": "{file:.opencode/agents/subagents/architect.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true
      }
    },
    "explorer": {
      "description": "Codebase exploration, file search, dependency analysis",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:.opencode/agents/subagents/explorer.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
        "read": true
      }
    },
    "project-context": {
      "description": "Project context agent - Reads and writes docs/ on demand. Knows the project structure and canonical documentation.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:.opencode/agents/subagents/project-context.md}",
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "glob": true,
        "grep": true
      }
    },
    "angular-expert": {
      "description": "Angular expert - answers questions about Angular framework, syntax, patterns, and ecosystem.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:.opencode/agents/subagents/angular-expert.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
        "read": true,
        "glob": true,
        "grep": true,
        "webfetch": true
      }
    },
    "opencode-expert": {
      "description": "Opencode expert - answers questions about opencode configuration, agents, and runtime.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:.opencode/agents/subagents/opencode-expert.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
        "read": true,
        "glob": true,
        "grep": true,
        "webfetch": true
      }
    },
    "vscode-expert": {
      "description": "VSCode expert - answers questions about VSCode editor, extensions, and configuration.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:.opencode/agents/subagents/vscode-expert.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
        "read": true,
        "glob": true,
        "grep": true,
        "webfetch": true
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "write": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "webfetch": "allow",
    "skill": "allow"
  },
  "instructions": [
    "docs/project.md",
    "docs/context/README.md",
    "docs/protocols/README.md",
    ".opencode/session-structure.md",
    ".opencode/protocols/README.md",
    ".opencode/model-routing.md",
    ".opencode/llm-routing.md"
  ]
}
