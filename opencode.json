{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "default_agent": "delivery",
  "instructions": [
    "docs/project.md"
  ],
  "mcp": {
    "angular-cli": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@angular/cli",
        "mcp"
      ],
      "enabled": true
    },
    "engram": {
      "command": [
        "/home/admin/.local/bin/engram",
        "mcp",
        "--project=global",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "question": "ask",
    "session_send": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      "*.env": "deny",
      "**/*.env": "deny",
      "*.env.*": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      "*.env": "deny",
      "**/*.env": "deny",
      "*.env.*": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.secret": "deny",
      "**/*.secret": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "docker *": "ask"
    }
  },
  "references": {
    "agent-system": {
      "path": ".",
      "description": "Global agent-system root (this repo, installed at ~/.config/opencode). Its assets (e.g. protocols/, workflows/, agents/, scripts/, tests/, templates/) are NOT resolvable by relative or alias paths — join THIS reference's absolute root with the relative path to read an asset (e.g. ROOT/protocols/prompt-pipeline.md). Never commit machine-specific absolute paths; resolve the root at runtime from this reference."
    }
  },
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "subagent_depth": 4
}
