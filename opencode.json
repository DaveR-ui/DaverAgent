{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "docs/project.md"
  ],

  "model": "llama.cpp/qwen35-local",
  "small_model": "llama.cpp/qwen35-local",

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen Local - llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen35-local": {
          "name": "Qwen3.5-35B-A3B Local",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },

  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 4096
    },
    "buffer": 4096
  },

  "permission": {
    "question": "ask",
    "session_send": "ask",

    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      "*.env": "deny",
      "**/*.env": "deny",
      "*.env.*": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow"
    },

    "edit": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      "*.env": "deny",
      "**/*.env": "deny",
      "*.env.*": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.secret": "deny",
      "**/*.secret": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny"
    },

    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "docker *": "ask"
    }
  },

  "references": {
    "agent-system": {
      "path": ".",
      "description": "Global agent-system root. Resolve agent-system assets such as agents/, protocols/, workflows/, scripts/, tests/, templates/, plugins/, and commands/ against this root."
    }
  },

  "subagent_depth": 4
}
