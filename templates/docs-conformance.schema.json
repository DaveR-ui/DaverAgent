{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system.local/templates/docs-conformance.schema.json",
  "title": "Docs conformance divergence register",
  "description": "Machine-checked register of every deliberate divergence between the upstream documentation-onrails validate.js rules and this project's derived templates/docs-validate.js. Single declared-divergence authority.",
  "type": "object",
  "required": ["version", "onrails", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Register format version."
    },
    "onrails": {
      "type": "object",
      "description": "Upstream baseline this register is compared against.",
      "required": ["version", "snapshot"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "snapshot": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "description": "One entry per declared divergence.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "a_rule",
          "b_behavior",
          "class",
          "rationale",
          "owner",
          "review_date",
          "test"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "a_rule": {
            "type": "string",
            "description": "Rule/behavior as defined upstream (A)."
          },
          "b_behavior": {
            "type": "string",
            "description": "Behavior as implemented in templates/docs-validate.js (B)."
          },
          "class": {
            "type": "string",
            "enum": [
              "accepted-adaptation",
              "accepted-severity-downgrade",
              "accepted-omission",
              "deferred"
            ]
          },
          "rationale": { "type": "string" },
          "owner": { "type": "string" },
          "review_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "test": {
            "type": "string",
            "description": "Shell command run from the repo root; exit 0 proves the divergence is still true of the code."
          }
        }
      }
    }
  }
}
