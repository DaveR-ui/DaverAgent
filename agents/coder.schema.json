{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoderOutput",
  "description": "Structured return for the coder subagent: files changed, test status, and a one-line summary.",
  "type": "object",
  "properties": {
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths of files created or modified."
    },
    "tests_run": {
      "type": "boolean",
      "description": "Whether tests were executed."
    },
    "tests_passed": {
      "type": "boolean",
      "description": "Whether all executed tests passed."
    },
    "summary": {
      "type": "string",
      "description": "One-line description of what was done."
    }
  },
  "required": [
    "files_changed",
    "tests_run",
    "tests_passed",
    "summary"
  ],
  "additionalProperties": false
}
